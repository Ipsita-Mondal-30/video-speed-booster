{
    "manifest_version": 3,
    "name": "Video Speed Booster",
    "version": "1.1",
    "description": "Boost video playback speed up to 4x or more with custom settings.",
    "permissions": ["scripting", "storage"],
    "host_permissions": ["*://*/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "48": "Untitled design.png",
        "128": "design.png"
      }
    },
    "icons": {
      
      "48": "Untitled design.png",
      "128": "design.png"
    }
  }
  
  